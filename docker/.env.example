IMAGE_REPO=tacticalrmm/
VERSION=latest

# tactical credentials (Used to login to dashboard)
# every CHANGE_ME must be replaced (e.g. `openssl rand -hex 24`); init refuses defaults
TRMM_USER=CHANGE_ME
TRMM_PASS=CHANGE_ME

# optional web port override settings
TRMM_HTTP_PORT=80
TRMM_HTTPS_PORT=443
# 127.0.0.1 when a host reverse proxy sits in front (then TRMM_NUM_PROXIES=2)
TRMM_BIND_ADDR=0.0.0.0
TRMM_NUM_PROXIES=1

# dns settings
APP_HOST=rmm.example.com
API_HOST=api.example.com
MESH_HOST=mesh.example.com

# keep session cookies off sibling subdomains, e.g. with hosts app.rmm / api.rmm /
# mesh.rmm.example.com set TRMM_COOKIE_DOMAIN=rmm.example.com
TRMM_COOKIE_DOMAIN=

# docker network for the proxy (change if it collides with another stack)
TRMM_PROXY_SUBNET=172.20.0.0/24
TRMM_NGINX_IP=172.20.0.20

# mesh settings
MESH_USER=tactical
MESH_PASS=CHANGE_ME
MONGODB_USER=mongouser
MONGODB_PASSWORD=CHANGE_ME
MESH_PERSISTENT_CONFIG=0

# database settings (a dedicated user, not the postgres superuser)
POSTGRES_USER=tacticalrmm
POSTGRES_PASS=CHANGE_ME

# shell access from the dashboard into the server containers (off by default)
TRMM_DISABLE_WEB_TERMINAL=True
TRMM_DISABLE_SERVER_SCRIPTS=True

# disable sso
TRMM_DISABLE_SSO=False

# EE reporting stays off until upstream fixes CVE-2026-129165
TRMM_DISABLE_REPORTING=True

# URL actions / webhooks may not reach private networks unless this is True
TRMM_URL_ACTION_ALLOW_PRIVATE=False
